        },
        buddy: {
          title: "Sleep Data Collection 📊",
          subtitle: "Sleep affects 14 different metabolic pathways!"
        }
      }
    };

    // NEW: Handle greeting acknowledgment
    const handleGreetingAcknowledgment = () => {
      setGreetingAcknowledged(true)
      setShowGreeting(false)
    }

    // NEW: Handle skip functionality
    const handleSkip = () => {
      // Mark current step as skipped
      setSkippedSteps(prev => new Set([...prev, currentStep]))
      
      // Move to next step
      if (currentStep < steps.length - 1) {
        onAnswer(currentStepData.id, 'skipped')
      } else {
        // Complete the flow
        setShowSummary(true)
        setShowGuidedFlow(false)
      }
    }

