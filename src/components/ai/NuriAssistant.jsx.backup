          {treeStages.map((stage, index) => (
            <motion.div
              key={stage.step}
              className={`flex flex-col items-center ${index <= currentStep ? 'opacity-100' : 'opacity-30'}`}
              initial={{ scale: 0, opacity: 0 }}
              animate={{ 
                scale: index <= currentStep ? 1 : 0.8,
                opacity: index <= currentStep ? 1 : 0.3
              }}
              transition={{ 
                delay: index * 0.1,
                type: "easeOut",
                stiffness: 200
              }}
            >
              <motion.div
                className={`text-3xl mb-2 ${index <= currentStep ? 'animate-pulse' : ''}`}
                animate={index <= currentStep ? {
                  scale: [1, 1.2, 1],
                  rotate: [0, 5, -5, 0]
                } : {}}
                transition={{ 
                  duration: 2,
                  repeat: Infinity,
                  repeatType: "reverse"
                }}
              >
                {stage.icon}
              </motion.div>
              <div className="text-xs text-gray-600 text-center max-w-20">
                {index <= currentStep ? stage.message : `Step ${stage.step}`}
              </div>
            </motion.div>
          ))}
        </div>
      </div>
    );
  };



    const currentStepData = steps[currentStep]
    const progress = ((currentStep + 1) / steps.length) * 100

