  }

  // Universal Questions - One Version for Everyone
  const guidedSteps = [
    {
      id: 'sleep',
      question: "How did you sleep last night? 😴",
      subtitle: "Your rest affects everything from energy to cravings",
      options: [
        { value: "7-9 hours, rested", label: "Great! Slept 7-9 hours and feeling rested", icon: "🌅" },
        { value: "6-7 hours, okay", label: "Pretty good - got around 6-7 hours", icon: "😌" },
        { value: "Less than 6 hours", label: "Not great - less than 6 hours or restless", icon: "😔" },
        { value: "Very poor", label: "Terrible - barely slept or very interrupted", icon: "😫" }
      ]
    },
    {
      id: 'activity',
      question: "How active are you in a typical week? 🏃‍♀️",
      subtitle: "This helps me calculate your energy needs accurately",
      options: [
        { value: "very_active", label: "Very active - intense exercise 5+ times per week", icon: "🔥" },
        { value: "moderately_active", label: "Moderately active - regular workouts 3-4 times per week", icon: "💪" },
        { value: "lightly_active", label: "Lightly active - walks, yoga, gentle movement", icon: "🚶‍♀️" },
        { value: "sedentary", label: "Mostly sedentary - desk work, minimal exercise", icon: "📚" }
      ]
    },
    {
      id: 'mood',
      question: "How are you feeling about your health journey today? 💭",
      subtitle: "There's no wrong answer - I want to meet you where you are",
      options: [
        { value: "excited", label: "Excited and motivated to make changes!", icon: "🌟" },
        { value: "optimistic", label: "Cautiously optimistic, ready to try", icon: "😊" },
        { value: "neutral", label: "Neutral - not sure what to expect", icon: "😐" },
        { value: "overwhelmed", label: "Overwhelmed or discouraged right now", icon: "😞" }
      ]
    },
    {
      id: 'eating',
      question: "How would you describe your relationship with food? 🍽️",
      subtitle: "This helps me understand your current patterns",
      options: [
        { value: "balanced", label: "Pretty balanced, I enjoy food without overthinking", icon: "🍎" },
        { value: "mindful", label: "I try to be mindful but sometimes struggle", icon: "🧘‍♀️" },
        { value: "emotional", label: "I often eat when stressed or emotional", icon: "😤" },
        { value: "restrictive", label: "I'm very careful, sometimes too restrictive", icon: "📏" }
      ]
    },
    {
      id: 'goal',
      question: "What's your primary wellness goal right now? 🎯",
      subtitle: "This helps me tailor your nutrition plan",
      options: [
        { value: "lose_weight", label: "Lose weight and feel lighter", icon: "⚖️" },
        { value: "gain_muscle", label: "Build muscle and strength", icon: "💪" },
        { value: "energy", label: "Have more energy throughout the day", icon: "⚡" },
        { value: "health", label: "Improve overall health and wellness", icon: "❤️" }
      ]
    },
    {
      id: 'hydration',
      question: "How's your hydration typically? 💧",
      subtitle: "Hydration affects everything from energy to metabolism",
      options: [
        { value: "excellent", label: "Excellent - I drink water regularly", icon: "💧" },
        { value: "good", label: "Good - I try to stay hydrated", icon: "🥤" },
        { value: "poor", label: "Poor - I often forget to drink water", icon: "🏜️" },
        { value: "variable", label: "Variable - depends on the day", icon: "🌊" }
      ]
    },
    {
      id: 'extras',
      question: "Any specific concerns or conditions I should know about? 🤔",
      subtitle: "This helps me provide more personalized advice",
      options: [
        { value: "none", label: "No specific concerns", icon: "✅" },
        { value: "stress", label: "High stress levels", icon: "😰" },
        { value: "digestive", label: "Digestive issues", icon: "🤢" },
        { value: "medical", label: "Medical conditions or medications", icon: "🏥" }
      ]
    }
  ]
  
  const {
    nuriState,
    currentPersonality,
    generateResponse,
    handleDailyCheckIn,
    generateMacroInsights,
    processJournalEntry,
    isProFeatureAvailable,
    getProUpgradeSuggestions,
    updateNuriState
  } = useNuriLogic()

  const { theme, timeOfDay, userMood, isDark, isStressed } = useAdaptiveTheme(nuriState.userMood)

  const [formData, setFormData] = useState({
    name: '',
    age: '',
    gender: '',
    height: '',
    weight: '',
    activityLevel: '',
    goal: ''
  })
  const [results, setResults] = useState(null)

  // Handle user input and generate Nuri response
  const handleUserInput = (input) => {
    if (!input.trim()) return

    // Add user message to conversation
    const userMessage = { type: 'user', message: input, timestamp: new Date() }
    setConversation(prev => [...prev, userMessage])
    setUserInput('')

    // Show typing indicator
    setIsTyping(true)

    // Simulate typing delay
    setTimeout(() => {
      // Generate Nuri's response
      const response = generateResponse(input, {
        macroData: results?.macros,
        exerciseToday: false // This would come from user data
      })

      // Add Nuri's response to conversation
      const nuriMessage = { type: 'nuri', message: response.message, timestamp: new Date() }
      setConversation(prev => [...prev, nuriMessage])
      setIsTyping(false)

      // Show health tip if available
      if (response.healthTip) {
        setShowHealthTip(true)
      }

      // Show check-in if needed
      if (response.shouldCheckIn) {
        setShowCheckIn(true)
      }
    }, 1500 + Math.random() * 1000) // Random delay for natural feel
  }

  // Handle daily check-in completion
  const handleCheckInComplete = (mood, notes) => {
    const response = handleDailyCheckIn(mood, notes)
    setConversation(prev => [...prev, { type: 'nuri', message: response.message, timestamp: new Date() }])
    setShowCheckIn(false)
  }

  // Handle journal entry
  const handleJournalEntry = (entry) => {
    const response = processJournalEntry(entry)
    setConversation(prev => [...prev, { type: 'nuri', message: response.message, timestamp: new Date() }])
  }

  // Handle guided flow completion
  const handleGuidedFlowComplete = (results) => {
    setGuidedResults(results)
    setShowGuidedFlow(false)
    // Add a success message to conversation
    setConversation(prev => [...prev, { 
      type: 'nuri', 
      message: "Great! I've created your personalized nutrition plan. Check out the results above! 🎉", 
      timestamp: new Date() 
    }])
  }

  // Handle guided flow skip
  const handleGuidedFlowSkip = () => {
    setShowGuidedFlow(false)
    setConversation(prev => [...prev, { 
      type: 'nuri', 
      message: "No worries! You can always come back to complete the guided assessment later. How can I help you today?", 
      timestamp: new Date() 
    }])
  }

  const handleGuidedAnswer = (stepId, answer) => {
    // Handle skipped answers
    if (answer === 'skipped') {
      // Batch state updates to prevent flashing
      const newAnswers = { ...guidedAnswers, [stepId]: 'skipped' }
      setGuidedAnswers(newAnswers)
      
      // Move to next step
      if (guidedStep < guidedSteps.length - 1) {
        setGuidedStep(prev => prev + 1)
      } else {
        // Complete the flow
        const results = calculatePersonalizedResults()
        // Batch these updates together
        setGuidedResults(results)
        setShowSummary(true)
        setShowGuidedFlow(false)
      }
      return
    }
    
    // Batch state updates to prevent flashing
    const newAnswers = { ...guidedAnswers, [stepId]: answer }
    setGuidedAnswers(newAnswers)
    
    // Enhanced conversational feedback
    const conversationalFeedback = {
      sleep: {
        "7-9 hours, rested": "Amazing! Great sleep is the foundation of everything. You're already winning! 🌟",
        "6-7 hours, okay": "Not bad! We can definitely work with that. Let's optimize it further! 😊",
        "Less than 6 hours": "I understand - sleep can be tricky. Let's work on that together. You're not alone! 💙",
        "Very poor": "Thank you for being honest. We'll address this together. Small steps lead to big changes! 🤗"
      },
      activity: {
        "very_active": "Wow! You're really active - that's fantastic! Your body will love the extra fuel! 🔥",
        "moderately_active": "Great balance! Regular movement is so important. You're doing great! 💪",
        "lightly_active": "Perfect! Every bit of movement counts. Let's build on that foundation! 🌱",
        "sedentary": "No judgment here! Let's find movement that works for you. We'll start small! 🚶‍♀️"
      },
      mood: {
        "excited": "I love your energy! Let's channel that into amazing results! You're going to crush this! ⭐",
        "optimistic": "That's a great mindset to start with! Optimism is powerful fuel! 🌟",
        "neutral": "Perfect! We'll build on that stable foundation. Sometimes neutral is exactly what we need! 🎯",
        "overwhelmed": "Thank you for being honest. We'll take this step by step. You've got this! 🤗"
      },
      eating: {
        "balanced": "That's wonderful! A balanced relationship with food is so healthy. You're ahead of the game! 🍎",
        "mindful": "Mindful eating is a superpower! Let's make it even easier for you! 🧘‍♀️",
        "emotional": "You're not alone in this. Let's build healthier coping strategies together! 💪",
        "restrictive": "Your health matters! Let's find a balanced approach that nourishes you! 🌸"
      },
      goal: {
        "lose_weight": "Great goal! Let's focus on sustainable, healthy changes. You're going to feel amazing! 🎯",
        "gain_muscle": "Excellent! Building strength is so empowering. Let's fuel those gains! 💪",
        "energy": "Love that! Energy is the foundation of everything else. Let's optimize your fuel! ⚡",
        "health": "Perfect! Health is wealth, and you're investing in yourself. Smart choice! ❤️"
      },
      hydration: {
        "excellent": "Fantastic! Hydration is so important for your body. You're already winning! 💧",
        "good": "Good effort! Let's make it even better. Small improvements add up! 🥤",
        "poor": "No worries! Let's make hydration a habit together. We'll start simple! 💪",
        "variable": "That's totally normal! Let's find consistency. We'll make it easy! 🌊"
      },
      extras: {
        "none": "Perfect! We'll focus on general optimization. Clean slate! 🎯",
        "stress": "Stress affects everything - let's address that together. You're not alone! 🧘‍♀️",
        "digestive": "Digestive health is crucial - we'll be mindful of that. Your body will thank you! 🌱",
        "medical": "Thank you for sharing. We'll work within your needs. Your health comes first! 🤗"
      }
    }
    
    // Get conversational feedback
    const feedback = conversationalFeedback[stepId]?.[answer] || "Thanks for sharing that with me! Let's continue."
    
    // Add feedback to conversation
    setConversation(prev => [...prev, { 
      type: 'nuri', 
      message: feedback,
      timestamp: new Date() 
    }])

    // Add transition message between steps
    if (guidedStep < guidedSteps.length - 1) {
      const transitionMessages = [
        "Great! Now let's move on to the next question...",
        "Perfect! Here's the next thing I'd like to know...",
        "Awesome! Let's continue with this next part...",
        "Excellent! Now for the next step in our journey...",
        "Wonderful! Let's keep going with this next question..."
      ]
      
      const randomTransition = transitionMessages[Math.floor(Math.random() * transitionMessages.length)]
      
      setTimeout(() => {
        setConversation(prev => [...prev, { 
          type: 'nuri', 
          message: randomTransition,
          timestamp: new Date() 
        }])
      }, 1000)
    }

    // Move to next step or complete
    if (guidedStep < guidedSteps.length - 1) {
      setGuidedStep(prev => prev + 1)
    } else {
      // Complete the flow and show summary - batch updates
      const results = calculatePersonalizedResults()
      setGuidedResults(results)
      setShowSummary(true)
      setShowGuidedFlow(false)
    }
  }

  const calculatePersonalizedResults = () => {
    // Simple calculation based on guided answers
    const { activity, goal } = guidedAnswers
    
    let baseCalories = 2000 // Base calculation
    let proteinRatio = 0.25
    let carbsRatio = 0.45
    let fatsRatio = 0.30

    // Adjust based on activity
    if (activity === 'very_active') baseCalories += 500
    else if (activity === 'moderate') baseCalories += 200
    else if (activity === 'sedentary') baseCalories -= 200

    // Adjust based on goal
    if (goal === 'weight_loss') baseCalories -= 300
    else if (goal === 'muscle') {
      baseCalories += 200
      proteinRatio = 0.30
      carbsRatio = 0.40
    }
    else if (goal === 'energy') {
      carbsRatio = 0.50
      proteinRatio = 0.25
      fatsRatio = 0.25
    }

    const proteinGrams = Math.round((baseCalories * proteinRatio) / 4)
    const carbsGrams = Math.round((baseCalories * carbsRatio) / 4)
    const fatsGrams = Math.round((baseCalories * fatsRatio) / 9)

    return {
      dailyCalories: baseCalories,
      macros: {
        protein: { grams: proteinGrams, percent: Math.round(proteinRatio * 100) },
        carbs: { grams: carbsGrams, percent: Math.round(carbsRatio * 100) },
        fats: { grams: fatsGrams, percent: Math.round(fatsRatio * 100) }
      },
      tip: getPersonalizedTip()
    }
  }

  const getPersonalizedTip = () => {
    const { mood, sleep, eating, activity, goal, hydration } = guidedAnswers
    
    if (sleep === 'poor') return "Prioritize 7-9 hours of sleep - it's the foundation of good health and metabolism."
    if (hydration === 'poor') return "Start your day with a glass of water and aim for 8 glasses daily."
    if (eating === 'skipping') return "Try eating within 1 hour of waking up to kickstart your metabolism."
    if (activity === 'sedentary') return "Add a 10-minute walk to your daily routine - every bit of movement counts!"
    if (goal === 'energy') return "Eat protein with every meal to maintain steady energy levels throughout the day."
    if (goal === 'weight_loss') return "Focus on whole foods and try eating slowly to recognize fullness cues."
    if (goal === 'muscle') return "Eat protein within 30 minutes after your workout for optimal muscle recovery."
    
    return "Consistency is key! Small, sustainable changes lead to lasting results."
  }

    // Guided Conversation Component - Memoized to prevent unnecessary re-renders
  const GuidedConversation = React.memo(({ steps, currentStep, onAnswer, answers }) => {
    const currentStepData = steps[currentStep]
    const progress = ((currentStep + 1) / steps.length) * 100

    // Dynamic greetings for Nuri
    const nuriGreetings = [
      "Hey there! I'm Nuri, your AI wellness assistant. Let's get started! ⭐",
      "Nuri here! How are you doing today? Ready to create your personalized plan? 💫",
      "Hi! I'm Nuri, and I'm excited to help you on your wellness journey! 💫",
      "Welcome! I'm Nuri, your AI companion. Let's make this journey amazing together! 🚀",
      "Hey! Nuri here. I can't wait to learn about you and create something special! ⭐"
    ]

    // Get a random greeting
    const randomGreeting = nuriGreetings[Math.floor(Math.random() * nuriGreetings.length)]

    // Make questions more conversational
    const conversationalQuestions = {
      sleep: "Alright, let's talk about your sleep. How did it go last night? 😴",
      activity: "Now, I'm curious about your activity level. How active are you in a typical week? 🏃‍♀️",
      mood: "I'd love to know how you're feeling about your health journey today. What's on your mind? 💭",
      eating: "Let's chat about your relationship with food. How would you describe it? 🍽️",
      goal: "This is exciting! What's your primary wellness goal right now? 🎯",
      hydration: "Quick question about hydration - how's your water intake typically? 💧",
      extras: "Almost done! Any specific concerns or conditions I should know about? 🤔"
    }

    // Enhanced questions with personality adaptation
    const enhancedQuestions = {
      sleep: {
        coach: {
          title: "Recovery Check! How's your sleep tank? ⛽",
          subtitle: "Great athletes know recovery = gains!"
        },
        guide: {
          title: "Let's talk about your rest... 😴",
          subtitle: "Sleep is when your body heals and recharges"
        },
        buddy: {
          title: "Sleep Data Collection 📊",
          subtitle: "Sleep affects 14 different metabolic pathways!"
        }
      }
    };

    // NEW: Handle greeting acknowledgment
    const handleGreetingAcknowledgment = () => {
      setGreetingAcknowledged(true)
      setShowGreeting(false)
    }

    // NEW: Handle skip functionality
    const handleSkip = () => {
      // Mark current step as skipped
      setSkippedSteps(prev => new Set([...prev, currentStep]))
      
      // Move to next step
      if (currentStep < steps.length - 1) {
        onAnswer(currentStepData.id, 'skipped')
      } else {
        // Complete the flow
        setShowSummary(true)
        setShowGuidedFlow(false)
      }
    }

    return (
      <motion.div
        initial={{ opacity: 0, y: 20 }}
        animate={{ opacity: 1, y: 0 }}
        transition={{ 
          duration: 0.5,
          ...nuriAnimationPresets.transition
        }}
        className="w-full"
      >
        {/* Wellness Tree Progress */}
        <WellnessTree currentStep={currentStep} answers={answers} />

        {/* Nuri's Greeting - Show first, then questions */}
        {showGreeting && !greetingAcknowledged && (
          <motion.div
            initial={{ opacity: 0, y: -20 }}
            animate={{ opacity: 1, y: 0 }}
            transition={{ delay: 0.3 }}
            className="bg-gradient-to-r from-blue-50 to-purple-50 rounded-xl p-6 mb-6 border border-blue-200"
          >
