                  <h4 className="text-lg font-semibold text-green-800 mb-2">Your Goal</h4>
                  <div className="text-xl font-bold text-green-900 capitalize">
                    {formData.goal === 'lose' ? 'Weight Loss' :
                     formData.goal === 'gain' ? 'Weight Gain' :
                     formData.goal === 'muscle' ? 'Build Muscle' :
                     formData.goal === 'energy' ? 'Improve Energy' :
                     formData.goal === 'health' ? 'Overall Health' :
                     'Maintain Weight'}
                  </div>
                </div>
              </Card>
            </div>

            {/* Macronutrients */}
            <div className="grid grid-cols-3 gap-4">
              <Card className="p-6 bg-gradient-to-br from-red-50 to-red-100 border-red-200 text-center">
                <h5 className="font-semibold text-red-800 mb-2">Protein</h5>
                <div className="text-2xl font-bold text-red-900">{results.macros.protein.grams}g</div>
                <div className="text-sm text-red-700">{results.macros.protein.percent}%</div>
              </Card>
              <Card className="p-6 bg-gradient-to-br from-yellow-50 to-yellow-100 border-yellow-200 text-center">
                <h5 className="font-semibold text-yellow-800 mb-2">Carbs</h5>
                <div className="text-2xl font-bold text-yellow-900">{results.macros.carbs.grams}g</div>
                <div className="text-sm text-yellow-700">{results.macros.carbs.percent}%</div>
              </Card>
              <Card className="p-6 bg-gradient-to-br from-purple-50 to-purple-100 border-purple-200 text-center">
                <h5 className="font-semibold text-purple-800 mb-2">Fats</h5>
                <div className="text-2xl font-bold text-purple-900">{results.macros.fats.grams}g</div>
                <div className="text-sm text-purple-700">{results.macros.fats.percent}%</div>
              </Card>
            </div>

            {/* Nuri's Insight */}
            <div className="p-6 bg-gradient-to-r from-brandStart/10 to-brandEnd/10 rounded-xl border border-brandStart/20">
              <div className="flex items-start gap-4">
                <div className="w-8 h-8 bg-gradient-to-r from-brandStart to-brandEnd rounded-full flex items-center justify-center">
                  <Sparkles className="w-4 h-4 text-white" />
                </div>
                <div>
                  <h4 className="font-semibold text-gray-800 mb-2">Nuri's Insight:</h4>
                  <p className="text-gray-700 leading-relaxed">
                    This nutrition plan gives your body the perfect fuel it needs! 
                    {formData.goal === 'muscle' && " Focus on hitting that protein target to support muscle growth."}
                    {formData.goal === 'lose' && " The higher protein will help preserve muscle while you lose fat."}
                    {formData.goal === 'energy' && " These balanced macros will keep your energy steady throughout the day."}
                    {formData.goal === 'health' && " This balanced approach supports overall wellness and vitality."}
                    {(formData.goal === 'maintain' || formData.goal === 'gain') && " This balanced plan supports your goals while maintaining optimal health."}
                  </p>
                </div>
              </div>
            </div>

            {/* Action Buttons */}
            <div className="flex justify-center gap-4 pt-4">
              <Button variant="outline" className="flex items-center gap-2">
                <Download className="w-4 h-4" />
                Save Plan
              </Button>
              <Button variant="outline" className="flex items-center gap-2">
                <Share2 className="w-4 h-4" />
                Share
              </Button>
              <Button 
                onClick={() => {
                  setCurrentStep(0)
                  setFormData({
                    name: '',
                    age: '',
                    gender: '',
                    height: '',
                    weight: '',
                    activityLevel: '',
                    goal: ''
                  })
                  setResults(null)
                }}
                className="flex items-center gap-2 bg-gradient-to-r from-brandStart to-brandEnd text-white"
              >
                <RefreshCw className="w-4 h-4" />
                Start Over
              </Button>
            </div>
          </div>
        ) : null

      default:
        return null
    }
  }

  const renderStep = () => {
    switch (currentStep) {
      case 0: // Welcome
        return (
          <div className="text-center">
            <div className="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
              <div className="p-6 bg-gradient-to-br from-green-50 to-emerald-100 border border-green-200 rounded-xl hover:scale-105 transition-transform duration-300 ease-in-out shadow-lg">
                <Calculator className="w-8 h-8 text-green-600 mx-auto mb-3" />
                <h3 className="font-semibold text-gray-800 mb-2">Precise Calculations</h3>
                <p className="text-sm text-gray-600">Science-based formulas for accurate results</p>
              </div>
              <div className="p-6 bg-gradient-to-br from-purple-50 to-indigo-100 border border-purple-200 rounded-xl hover:scale-105 transition-transform duration-300 ease-in-out shadow-lg">
                <Target className="w-8 h-8 text-purple-600 mx-auto mb-3" />
                <h3 className="font-semibold text-gray-800 mb-2">Personal Targets</h3>
                <p className="text-sm text-gray-600">Customized goals for your body type</p>
              </div>
              <div className="p-6 bg-gradient-to-br from-orange-50 to-red-100 border border-orange-200 rounded-xl hover:scale-105 transition-transform duration-300 ease-in-out shadow-lg">
                <TrendingUp className="w-8 h-8 text-orange-600 mx-auto mb-3" />
                <h3 className="font-semibold text-gray-800 mb-2">Progress Tracking</h3>
                <p className="text-sm text-gray-600">Monitor your health journey</p>
              </div>
            </div>
            <p className="text-gray-600 text-lg">
              Let's create your personalized nutrition plan together!
            </p>
          </div>
        )
      case 1: // Name
        return (
          <div className="text-center">
            <h3 className="text-xl font-semibold mb-4 text-gray-800">What's your name?</h3>
            <input
              type="text"
              value={formData.name}
              onChange={(e) => updateFormData('name', e.target.value)}
              placeholder="Enter your name"
              className="w-full max-w-md p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brandStart focus:border-transparent"
            />
          </div>
        )
      case 2: // Demographics
        return (
          <div className="space-y-4">
            <h3 className="text-xl font-semibold mb-4 text-gray-800">Tell us about yourself</h3>
            <div className="grid grid-cols-2 gap-4">
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">Age</label>
                <input
                  type="number"
                  value={formData.age}
                  onChange={(e) => updateFormData('age', e.target.value)}
                  placeholder="25"
                  className="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brandStart focus:border-transparent"
                />
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">Gender</label>
                <select
                  value={formData.gender}
                  onChange={(e) => updateFormData('gender', e.target.value)}
                  className="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brandStart focus:border-transparent"
                >
                  <option value="">Select gender</option>
                  <option value="male">Male</option>
                  <option value="female">Female</option>
                  <option value="other">Other</option>
                </select>
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">Height (cm)</label>
                <input
                  type="number"
                  value={formData.height}
                  onChange={(e) => updateFormData('height', e.target.value)}
                  placeholder="170"
                  className="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brandStart focus:border-transparent"
                />
              </div>
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">Weight (kg)</label>
                <input
                  type="number"
                  value={formData.weight}
                  onChange={(e) => updateFormData('weight', e.target.value)}
                  placeholder="70"
                  className="w-full p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-brandStart focus:border-transparent"
                />
              </div>
            </div>
          </div>
        )
      case 3: // Activity Level
        return (
          <div className="text-center">
            <h3 className="text-xl font-semibold mb-4 text-gray-800">How active are you?</h3>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              {[
                { value: 'sedentary', label: 'Sedentary', desc: 'Little to no exercise' },
                { value: 'light', label: 'Lightly Active', desc: 'Light exercise 1-3 days/week' },
                { value: 'moderate', label: 'Moderately Active', desc: 'Moderate exercise 3-5 days/week' },
                { value: 'active', label: 'Very Active', desc: 'Hard exercise 6-7 days/week' },
                { value: 'very_active', label: 'Extremely Active', desc: 'Very hard exercise, physical job' }
              ].map((option) => (
                <button
                  key={option.value}
                  onClick={() => updateFormData('activityLevel', option.value)}
                  className={`p-4 border rounded-lg text-left transition-all ${
                    formData.activityLevel === option.value
                      ? 'border-brandStart bg-brandStart/10 text-brandStart'
                      : 'border-gray-300 hover:border-brandStart/50'
                  }`}
                >
                  <div className="font-medium">{option.label}</div>
                  <div className="text-sm text-gray-600">{option.desc}</div>
                </button>
              ))}
            </div>
          </div>
        )
      case 4: // Goal
        return (
          <div className="text-center">
            <h3 className="text-xl font-semibold mb-4 text-gray-800">What's your goal?</h3>
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              {[
                { value: 'lose', label: 'Lose Weight', desc: 'Reduce body fat' },
                { value: 'maintain', label: 'Maintain Weight', desc: 'Stay at current weight' },
                { value: 'gain', label: 'Gain Weight', desc: 'Build muscle mass' },
                { value: 'muscle', label: 'Build Muscle', desc: 'Focus on muscle growth' },
                { value: 'energy', label: 'Improve Energy', desc: 'Boost daily energy levels' },
                { value: 'health', label: 'Overall Health', desc: 'General wellness' }
              ].map((option) => (
                <button
                  key={option.value}
                  onClick={() => updateFormData('goal', option.value)}
                  className={`p-4 border rounded-lg text-left transition-all ${
                    formData.goal === option.value
                      ? 'border-brandStart bg-brandStart/10 text-brandStart'
                      : 'border-gray-300 hover:border-brandStart/50'
                  }`}
                >
                  <div className="font-medium">{option.label}</div>
                  <div className="text-sm text-gray-600">{option.desc}</div>
                </button>
              ))}
            </div>
          </div>
        )
      case 5: // Calculate
        return (
          <div className="text-center">
            <h3 className="text-xl font-semibold mb-4 text-gray-800">Ready to calculate your nutrition plan?</h3>
            <p className="text-gray-600 mb-6">
              Based on your information, I'll calculate your personalized calorie and macronutrient needs.
            </p>
            <div className="bg-gray-50 p-4 rounded-lg text-left">
              <h4 className="font-medium mb-2">Your Information:</h4>
              <div className="text-sm text-gray-600 space-y-1">
                <div>Name: {formData.name}</div>
                <div>Age: {formData.age} years</div>
                <div>Gender: {formData.gender}</div>
                <div>Height: {formData.height} cm</div>
                <div>Weight: {formData.weight} kg</div>
                <div>Activity: {formData.activityLevel}</div>
                <div>Goal: {formData.goal}</div>
              </div>
            </div>
          </div>
        )
      case 6: // Results
        return results ? (
          <div className="space-y-6">
            <div className="text-center">
              <h3 className="text-2xl font-semibold mb-2 text-gray-800">Your Personalized Nutrition Plan</h3>
              <p className="text-gray-600">Here's what your body needs to reach your goals</p>
            </div>

            {/* Summary Cards */}
            <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
              <Card className="p-6 bg-gradient-to-br from-blue-50 to-blue-100 border-blue-200">
                <div className="text-center">
                  <Calculator className="w-8 h-8 text-blue-600 mx-auto mb-3" />
                  <h4 className="text-lg font-semibold text-blue-800 mb-2">Daily Calories</h4>
                  <div className="text-3xl font-bold text-blue-900">{results.targetCalories}</div>
                  <p className="text-sm text-blue-700 mt-1">per day</p>
                </div>
              </Card>

              {/* Goal Badge */}
              <Card className="p-6 bg-gradient-to-br from-green-50 to-green-100 border-green-200">
                <div className="text-center">
                  <Target className="w-8 h-8 text-green-600 mx-auto mb-3" />
                  <h4 className="text-lg font-semibold text-green-800 mb-2">Your Goal</h4>
                  <div className="text-xl font-bold text-green-900 capitalize">
                    {formData.goal === 'lose' ? 'Weight Loss' :
                     formData.goal === 'gain' ? 'Weight Gain' :
                     formData.goal === 'muscle' ? 'Build Muscle' :
                     formData.goal === 'energy' ? 'Improve Energy' :
                     formData.goal === 'health' ? 'Overall Health' :
                     'Maintain Weight'}
                  </div>
                </div>
              </Card>
            </div>

            {/* Macronutrients */}
            <div className="grid grid-cols-3 gap-4">
              <Card className="p-6 bg-gradient-to-br from-red-50 to-red-100 border-red-200 text-center">
                <h5 className="font-semibold text-red-800 mb-2">Protein</h5>
                <div className="text-2xl font-bold text-red-900">{results.macros.protein.grams}g</div>
                <div className="text-sm text-red-700">{results.macros.protein.percent}%</div>
              </Card>
              <Card className="p-6 bg-gradient-to-br from-yellow-50 to-yellow-100 border-yellow-200 text-center">
                <h5 className="font-semibold text-yellow-800 mb-2">Carbs</h5>
                <div className="text-2xl font-bold text-yellow-900">{results.macros.carbs.grams}g</div>
                <div className="text-sm text-yellow-700">{results.macros.carbs.percent}%</div>
              </Card>
              <Card className="p-6 bg-gradient-to-br from-purple-50 to-purple-100 border-purple-200 text-center">
                <h5 className="font-semibold text-purple-800 mb-2">Fats</h5>
                <div className="text-2xl font-bold text-purple-900">{results.macros.fats.grams}g</div>
                <div className="text-sm text-purple-700">{results.macros.fats.percent}%</div>
              </Card>
            </div>

            {/* Nuri's Insight */}
            <div className="p-6 bg-gradient-to-r from-brandStart/10 to-brandEnd/10 rounded-xl border border-brandStart/20">
              <div className="flex items-start gap-4">
                <div className="w-8 h-8 bg-gradient-to-r from-brandStart to-brandEnd rounded-full flex items-center justify-center">
                  <Sparkles className="w-4 h-4 text-white" />
                </div>
                <div>
                  <h4 className="font-semibold text-gray-800 mb-2">Nuri's Insight:</h4>
                  <p className="text-gray-700 leading-relaxed">
                    This nutrition plan gives your body the perfect fuel it needs! 
                    {formData.goal === 'muscle' && " Focus on hitting that protein target to support muscle growth."}
                    {formData.goal === 'lose' && " The higher protein will help preserve muscle while you lose fat."}
                    {formData.goal === 'energy' && " These balanced macros will keep your energy steady throughout the day."}
                    {formData.goal === 'health' && " This balanced approach supports overall wellness and vitality."}
                    {(formData.goal === 'maintain' || formData.goal === 'gain') && " This balanced plan supports your goals while maintaining optimal health."}
                  </p>
                </div>
              </div>
            </div>

            {/* Action Buttons */}
            <div className="flex justify-center gap-4 pt-4">
              <Button variant="outline" className="flex items-center gap-2">
                <Download className="w-4 h-4" />
                Save Plan
              </Button>
              <Button variant="outline" className="flex items-center gap-2">
                <Share2 className="w-4 h-4" />
                Share
              </Button>
              <Button 
                onClick={() => {
                  setCurrentStep(0)
                  setFormData({
                    name: '',
                    age: '',
                    gender: '',
                    height: '',
                    weight: '',
                    activityLevel: '',
                    goal: ''
                  })
                  setResults(null)
                }}
                className="flex items-center gap-2 bg-gradient-to-r from-brandStart to-brandEnd text-white"
              >
                <RefreshCw className="w-4 h-4" />
                Start Over
              </Button>
            </div>
          </div>
        ) : null

      default:
        return null
    }
  }



  // Handle guided flow start
  const handleStartGuidedFlow = () => {
    setShowGuidedFlow(true)
  }

  // Safety check - show loading if critical objects are undefined
  if (!currentPersonality || !nuriState || !theme) {
    // Critical objects undefined, showing loading state
    return (
      <div className="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center">
        <div className="text-center">
          <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-blue-600 mx-auto mb-4"></div>
          <p className="text-gray-600">Loading assistant...</p>
          <p className="text-sm text-gray-500 mt-2">Please wait while we initialize Nuri</p>
        </div>
      </div>
    )
  }

  return (
    <>
      <style>{scrollbarHideStyles}</style>
      <div className="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100 py-8 px-4 transition-all duration-1000 relative overflow-hidden">
      {/* Animated Background Elements */}
      <div className="absolute inset-0 overflow-hidden pointer-events-none">
        <div className="absolute top-20 left-20 w-32 h-32 bg-gradient-to-r from-brandStart/10 to-brandEnd/10 rounded-full animate-float" />
        <div className="absolute top-40 right-32 w-24 h-24 bg-gradient-to-r from-accent-coral/10 to-accent-golden/10 rounded-full animate-float" style={{ animationDelay: '2s' }} />
        <div className="absolute bottom-32 left-1/4 w-16 h-16 bg-gradient-to-r from-success/10 to-info/10 rounded-full animate-bounce-gentle" />
        <div className="absolute top-1/2 left-1/4 w-20 h-20 bg-gradient-to-r from-purple-400/8 to-pink-400/8 rounded-full animate-pulse" style={{ animationDelay: '1.5s' }} />
        <div className="absolute bottom-1/3 right-1/4 w-12 h-12 bg-gradient-to-r from-green-400/8 to-blue-400/8 rounded-full animate-bounce" style={{ animationDelay: '0.5s' }} />
        <div className="absolute top-1/3 right-1/3 w-8 h-8 bg-gradient-to-r from-yellow-400/6 to-orange-400/6 rounded-full animate-ping" style={{ animationDelay: '3s' }} />
      </div>

      {/* FIXED: Centered Grid Layout */}
      <div className="max-w-7xl mx-auto relative z-10">
        
        {/* Enhanced Nuri Status Indicator */}
        <motion.div 
          className="fixed top-8 left-8 z-50"
          initial={{ opacity: 0, scale: 0 }}
          animate={{ opacity: 1, scale: 1 }}
          transition={{ delay: 0.5, type: "spring" }}
        >
          <AnimatedCard 
            className={`${theme?.card || 'bg-white'} shadow-xl`}
            shimmer={nuriState?.proEnabled || false}
            glow={isStressed}
          >
            <div className="flex items-center gap-3 px-4 py-2">
              <NuriAvatar 
                size="small" 
                variant="excited" 
                speaking={false}
              />
              <span className={`text-sm font-medium ${theme?.text || 'text-gray-700'}`}>
                Nuri is here
                {timeOfDay === 'morning' && ' 🌅'}
                {timeOfDay === 'afternoon' && ' ☀️'}
                {timeOfDay === 'evening' && ' 🌆'}
                {timeOfDay === 'night' && ' 🌙'}
              </span>
              {nuriState?.proEnabled && (
                <Crown className="w-4 h-4 text-yellow-500 animate-pulse" />
              )}
            </div>
          </AnimatedCard>
        </motion.div>

        {/* FIXED: Main Grid Layout */}
        <motion.div 
          className="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-12"
          initial={{ opacity: 0, y: 20 }}
          animate={{ opacity: 1, y: 0 }}
          transition={{ duration: 0.6, delay: 0.2 }}
        >
          {/* Left Panel - Wellness Journey & Content */}
          <motion.div 
            className="lg:col-span-2 flex flex-col gap-6"
            initial={{ opacity: 0, x: -20 }}
            animate={{ opacity: 1, x: 0 }}
            transition={{ duration: 0.5, delay: 0.4 }}
          >
            {/* HERO NURI SECTION - Main Focus */}
            <motion.div
              initial={{ opacity: 0, y: -20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: 0.3 }}
              className="text-center mb-8"
            >
              {/* Large Nuri Avatar - Hero Position */}
              <motion.div
                className="flex justify-center mb-6"
                initial={{ scale: 0 }}
                animate={{ scale: 1 }}
                transition={{ delay: 0.4, type: "spring", stiffness: 200 }}
              >
                <div className="relative">
                  <NuriAvatar 
                    size="xlarge" 
                    variant="excited" 
                    speaking={true}
                    className="w-24 h-24 md:w-32 md:h-32"
                  />
                  {/* Speaking indicator */}
                  <motion.div
                    className="absolute -top-2 -right-2 w-6 h-6 bg-blue-400 rounded-full opacity-75"
                    animate={{
                      scale: [1, 1.2, 1],
                      opacity: [0.75, 0.3, 0.75]
                    }}
                    transition={{
                      duration: 1.5,
                      repeat: Infinity,
                      ease: "easeInOut"
                    }}
                  />
                </div>
              </motion.div>

              {/* Nuri's Welcome Message */}
              <motion.div
                initial={{ opacity: 0, y: 20 }}
                animate={{ opacity: 1, y: 0 }}
                transition={{ delay: 0.6 }}
                className="max-w-2xl mx-auto"
              >
                <h2 className="text-3xl font-bold text-gray-800 mb-4">
                  Welcome! I'm Nuri 🌱
                </h2>
                <p className="text-lg text-gray-600 mb-4 leading-relaxed">
                  Your AI wellness companion ready to make this journey amazing together! 
                  Let's build healthy habits and grow together. ⭐
                </p>
                
                {/* Credibility Badge */}
                <motion.div
                  initial={{ opacity: 0, scale: 0.8 }}
                  animate={{ opacity: 1, scale: 1 }}
                  transition={{ delay: 0.8 }}
                  className="bg-gradient-to-r from-blue-50 to-green-50 border border-blue-200 rounded-lg p-3 mb-4"
                >
                  <div className="flex items-center justify-center gap-2">
                    <div className="w-4 h-4 bg-blue-500 rounded-full flex items-center justify-center">
                      <span className="text-white text-xs">✓</span>
                    </div>
                    <span className="text-sm font-medium text-blue-700">
                      Powered by trusted sources
                    </span>
                  </div>
                  <p className="text-xs text-gray-600 text-center mt-1">
                    Unlike other apps, I source my insights from Health Canada and USDA - the gold standard in nutrition data
                  </p>
                </motion.div>
                
                {/* Status indicator */}
                <div className="flex items-center justify-center gap-2 mb-6">
                  <div className="w-2 h-2 bg-green-500 rounded-full animate-pulse"></div>
                  <span className="text-sm text-gray-500 font-medium">Ready to help</span>
                </div>
              </motion.div>
            </motion.div>

            {/* Conversation Area - Centered around Nuri */}
            <motion.div 
              className="relative flex justify-center"
            >
              {!showGuidedFlow && !showSummary ? (
                <WelcomeScreen />
              ) : showGuidedFlow ? (
                <div className="w-full max-w-2xl">
                  <GuidedConversation 
                    key="guided-conversation"
                    steps={guidedSteps}
                    currentStep={guidedStep}
                    onAnswer={handleGuidedAnswer}
                    answers={guidedAnswers}
                  />
                </div>
              ) : showSummary ? (
                <div className="w-full max-w-2xl">
                  <PersonalizedSummary 
                    results={guidedResults}
                    onRestart={() => {
                      setGuidedStep(0)
                      setGuidedAnswers({})
                      setShowSummary(false)
                      setShowGuidedFlow(true)
                    }}
                    answers={guidedAnswers}
                  />
                </div>
              ) : (
                <AnimatedCard 
                  className={`${theme?.card || 'bg-white'} shadow-xl max-w-2xl`}
                  delay={0.2}
                  shimmer={nuriState?.proEnabled || false}
                >
                  <div className="p-8">
                    {/* Welcome Message */}
                    {conversation.length === 0 && (
                      <motion.div
                        initial={{ opacity: 0, y: 20 }}
                        animate={{ opacity: 1, y: 0 }}
                        className="text-center mb-8"
                      >
                        {!currentPersonality ? (
                          <div className="text-center">
                            <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mx-auto mb-4"></div>
                            <p className="text-gray-600">Loading assistant...</p>
                          </div>
                        ) : (
                          <>
                            <div className="flex items-center justify-center gap-2 mb-4">
                              <Sparkles className={`w-6 h-6 ${theme?.text?.replace('text-', 'text-') || 'text-gray-600'}`} />
                              <h2 className={`text-2xl font-semibold ${theme?.text || 'text-gray-800'}`}>
                                {currentPersonality?.greeting || "Hi! I'm Nuri, your health companion. How can I help you today?"}
                              </h2>
                            </div>
                            <p className="text-gray-600">
                              I'm here to support your health journey. How can I help you today?
                            </p>
                          </>
                        )}
                      </motion.div>
                    )}

                  {/* Conversation History */}
                  <div className="space-y-4 mb-6 max-h-96 overflow-y-auto">
                    {conversation.map((message, index) => (
                      <motion.div
                        key={index}
                        initial={{ opacity: 0, x: message.type === 'user' ? 20 : -20 }}
                        animate={{ opacity: 1, x: 0 }}
                        className={`flex ${message.type === 'user' ? 'justify-end' : 'justify-start'}`}
                      >
                        <AnimatedCard
                          className={`max-w-xs lg:max-w-md p-3 rounded-2xl ${
                            message.type === 'user' 
                              ? `bg-gradient-to-r ${theme?.primary || 'from-blue-500 to-indigo-600'} text-white` 
                              : 'bg-gray-100 text-gray-800'
                          }`}
                          hover={false}
                          delay={index * 0.1}
                        >
                          <p className="text-sm">{message.message}</p>
                        </AnimatedCard>
                      </motion.div>
                    ))}
                    
                    {/* Typing Indicator */}
                    <TypingIndicator isTyping={isTyping} theme={timeOfDay} />
                  </div>

                  {/* Enhanced Input Area - Only for Pro Users */}
                  {nuriState?.proEnabled && (
                    <div className="flex gap-2">
                      <input
                        type="text"
                        value={userInput}
                        onChange={(e) => setUserInput(e.target.value)}
                        onKeyPress={(e) => e.key === 'Enter' && handleUserInput(userInput)}
                        placeholder="Tell Nuri how you're feeling..."
                        className={`flex-1 p-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-opacity-50 focus:border-transparent transition-all duration-300 ${
                          theme?.primary?.includes('blue') ? 'focus:ring-blue-500' :
                          theme?.primary?.includes('green') ? 'focus:ring-green-500' :
                          theme?.primary?.includes('purple') ? 'focus:ring-purple-500' :
                          'focus:ring-blue-500'
                        }`}
                      />
                      <Button
                        onClick={() => handleUserInput(userInput)}
                        disabled={!userInput.trim()}
                        className={`bg-gradient-to-r ${theme?.primary || 'from-blue-500 to-indigo-600'} hover:opacity-90 text-white transition-all duration-300`}
                      >
                        <MessageCircle className="w-4 h-4" />
                      </Button>
                    </div>
                  )}

                  {/* Free User Message */}
                  {!nuriState?.proEnabled && conversation.length > 0 && (
                    <div className="text-center p-4 bg-gradient-to-r from-blue-50 to-indigo-50 rounded-lg border border-blue-200">
                      <p className="text-sm text-gray-600 mb-2">
                        💡 Want unlimited conversations with Nuri?
                      </p>
                      <div className="flex gap-2 justify-center">
                        <Button 
                          className="bg-gradient-to-r from-brandStart to-brandEnd text-white text-sm"
                          onClick={() => setShowGuidedFlow(true)}
                        >
                          Start Guided Assessment
                        </Button>
                        <Button 
                          variant="outline"
                          className="text-sm"
                          onClick={() => setShowGuidedFlow(true)}
                        >
                          Restart Assessment
                        </Button>
                      </div>
                    </div>
                  )}
                </div>
              </AnimatedCard>
            )}
            </motion.div>

            {/* MINIMIZED Progress Growth Section */}
            <motion.div
              initial={{ opacity: 0, scale: 0.8 }}
              animate={{ opacity: 1, scale: 1 }}
              transition={{ delay: 0.8 }}
              className="bg-gradient-to-r from-green-50 to-blue-50 rounded-xl p-4 border border-green-200 mb-6"
            >
              <div className="flex items-center justify-between mb-3">
                <h3 className="text-sm font-semibold text-gray-800">Your Wellness Journey</h3>
                <div className="flex gap-1">
                  {[...Array(7)].map((_, i) => (
                    <div
                      key={i}
                      className={`w-2 h-2 rounded-full ${
                        i < 4 ? 'bg-green-500' : 'bg-gray-300'
                      }`}
                    />
                  ))}
                </div>
              </div>
              <div className="flex items-center justify-center h-12">
                <div className="relative">
                  <div className="w-8 h-8 bg-gradient-to-r from-green-400 to-blue-500 rounded-full flex items-center justify-center">
                    <span className="text-sm">🌱</span>
                  </div>
                  <div className="absolute -top-1 -right-1 w-3 h-3 bg-yellow-400 rounded-full flex items-center justify-center">
                    <span className="text-xs">⭐</span>
                  </div>
                </div>
              </div>
              <p className="text-center text-xs text-gray-600 mt-2">
                Day 7 - Your wellness plant is growing strong! Keep up the great work.
              </p>
            </motion.div>

            {/* Quick Actions Row */}
            <motion.div
              initial={{ opacity: 0, y: 20 }}
              animate={{ opacity: 1, y: 0 }}
              transition={{ delay: 0.9 }}
              className="flex gap-3 justify-center"
            >
              <Button 
                variant="outline"
                className="flex items-center gap-2 bg-white hover:bg-gray-50"
              >
                <span>📷</span>
                Log Food
              </Button>
              <Button 
                variant="outline"
                className="flex items-center gap-2 bg-white hover:bg-gray-50"
              >
                <span>💧</span>
                Add Water
              </Button>
              <Button 
                variant="outline"
                className="flex items-center gap-2 bg-white hover:bg-gray-50"
              >
                <span>🏃</span>
                Log Activity
              </Button>
            </motion.div>
          </motion.div>

          {/* Right Panel - Progress Dashboard */}
          <motion.div 
            className="space-y-4"
            initial={{ opacity: 0, x: 20 }}
            animate={{ opacity: 1, x: 0 }}
            transition={{ duration: 0.5, delay: 0.6 }}
          >
              {/* Enhanced Progress Dashboard */}
              <GlassCard 
                className="shadow-xl hover:shadow-2xl transition-all duration-300"
                delay={0.4}
                shimmer={nuriState?.proEnabled || false}
              >
                <div className="p-4">
                  <div className="flex items-center gap-2 mb-3">
                    <TrendingUp className="w-5 h-5 text-brandStart" />
                    <h3 className="text-lg font-semibold text-gray-800">
                      Today's Progress
                    </h3>
                    <div className="ml-auto">
                      <div className="w-2 h-2 bg-green-500 rounded-full animate-pulse" title="Active tracking"></div>
                    </div>
                  </div>
                  
                  {/* NEW: Clear Example Data Label */}
                  <div className="mb-3 p-2 bg-blue-50 rounded-lg border border-blue-200">
                    <p className="text-xs text-blue-600 text-center font-medium">
                      📊 (Example Data)
                    </p>
                  </div>
                  
                  {/* Progress Indicators - COMPACT CARDS */}
                  <div className="space-y-3">
                    <div className="flex items-center justify-between p-3 bg-gradient-to-r from-red-50 to-orange-50 rounded-lg border border-red-100 hover:shadow-md transition-shadow duration-200" style={{ maxHeight: '100px' }}>
                      <div className="flex items-center gap-3">
                        <div className="w-8 h-8 bg-gradient-to-r from-red-400 to-orange-400 rounded-full flex items-center justify-center">
                          <Zap className="w-4 h-4 text-white" />
                        </div>
                        <div>
                          <p className="font-medium text-gray-800 text-sm">Energy Level</p>
                          <p className="text-xs text-gray-500">Based on your activity</p>
                        </div>
                      </div>
                      <div className="text-center">
                        <motion.div 
                          className="text-lg font-bold text-red-600"
                          initial={{ scale: 0 }}
                          animate={{ scale: 1 }}
                          transition={{ delay: 0.2, type: "spring", stiffness: 200 }}
                        >
                          {macroProgress.protein >= 80 ? 'High' : macroProgress.protein >= 50 ? 'Moderate' : 'Low'}
                        </motion.div>
                        <div className="text-xs text-gray-500">
                          {macroProgress.protein >= 80 ? 'Excellent' : macroProgress.protein >= 50 ? 'Good' : 'Needs attention'}
                        </div>
                      </div>
                    </div>
                    <div className="flex items-center justify-between p-3 bg-gradient-to-r from-yellow-50 to-amber-50 rounded-lg border border-yellow-100 hover:shadow-md transition-shadow duration-200" style={{ maxHeight: '100px' }}>
                      <div className="flex items-center gap-3">
                        <div className="w-8 h-8 bg-gradient-to-r from-yellow-400 to-amber-400 rounded-full flex items-center justify-center">
                          <Heart className="w-4 h-4 text-white" />
                        </div>
                        <div>
                          <p className="font-medium text-gray-800 text-sm">Mood</p>
                          <p className="text-xs text-gray-500">How you're feeling</p>
                        </div>
                      </div>
                      <div className="text-center">
                        <motion.div 
                          className="text-lg font-bold text-yellow-600"
                          initial={{ scale: 0 }}
                          animate={{ scale: 1 }}
                          transition={{ delay: 0.4, type: "spring", stiffness: 200 }}
                        >
                          {macroProgress.carbs >= 80 ? 'High' : macroProgress.carbs >= 50 ? 'Moderate' : 'Low'}
                        </motion.div>
                        <div className="text-xs text-gray-500">
                          {macroProgress.carbs >= 80 ? 'Excellent' : macroProgress.carbs >= 50 ? 'Good' : 'Needs attention'}
                        </div>
                      </div>
                    </div>
                    <div className="flex items-center justify-between p-3 bg-gradient-to-r from-purple-50 to-indigo-50 rounded-lg border border-purple-100 hover:shadow-md transition-shadow duration-200" style={{ maxHeight: '100px' }}>
                      <div className="flex items-center gap-3">
                        <div className="w-8 h-8 bg-gradient-to-r from-purple-400 to-indigo-400 rounded-full flex items-center justify-center">
                          <Target className="w-4 h-4 text-white" />
                        </div>
                        <div>
                          <p className="font-medium text-gray-800 text-sm">Focus</p>
                          <p className="text-xs text-gray-500">Mental clarity</p>
                        </div>
                      </div>
                      <div className="text-center">
                        <motion.div 
                          className="text-lg font-bold text-purple-600"
                          initial={{ scale: 0 }}
                          animate={{ scale: 1 }}
                          transition={{ delay: 0.6, type: "spring", stiffness: 200 }}
                        >
                          {macroProgress.fats >= 80 ? 'High' : macroProgress.fats >= 50 ? 'Moderate' : 'Low'}
                        </motion.div>
                        <div className="text-xs text-gray-500">
                          {macroProgress.fats >= 80 ? 'Excellent' : macroProgress.fats >= 50 ? 'Good' : 'Needs attention'}
                        </div>
                      </div>
                    </div>
                  </div>
                  
                  {/* NEW: Nuri's Tip Section - COMPACT */}
                  <div className="mt-4 p-3 bg-gradient-to-r from-green-50 to-blue-50 rounded-lg border border-green-200">
                    <div className="flex items-center gap-2 mb-2">
                      <NuriAvatar size="small" variant="excited" speaking={false} />
                      <h4 className="font-semibold text-gray-800 text-sm">Nuri's Tip</h4>
                    </div>
                    <p className="text-xs text-gray-700 leading-relaxed">
                      A balanced breakfast can help stabilize your energy levels for the day! Try including protein, healthy fats, and complex carbs. 🌅
                    </p>
                  </div>
                  
                  {/* NEW: Daily Streak Tracker - COMPACT */}
                  <div className="mt-4 p-3 bg-gradient-to-r from-orange-50 to-red-50 rounded-lg border border-orange-200">
                    <div className="flex items-center justify-between mb-2">
                      <div className="flex items-center gap-2">
                        <div className="w-5 h-5 bg-gradient-to-r from-orange-400 to-red-400 rounded-full flex items-center justify-center">
                          <Star className="w-3 h-3 text-white" />
                        </div>
                        <h4 className="font-semibold text-gray-800 text-sm">Daily Streak</h4>
                      </div>
                      <div className="text-right">
                        <div className="text-xl font-bold text-orange-600">7</div>
                        <div className="text-xs text-gray-500">days</div>
                      </div>
                    </div>
                    <div className="flex gap-1">
                      {[...Array(7)].map((_, i) => (
                        <motion.div
                          key={i}
                          className={`w-6 h-1.5 rounded-full ${i < 7 ? 'bg-gradient-to-r from-orange-400 to-red-400' : 'bg-gray-200'}`}
                          initial={{ scale: 0 }}
                          animate={{ scale: 1 }}
                          transition={{ delay: i * 0.1 }}
                        />
                      ))}
                    </div>
                    <p className="text-xs text-gray-600 mt-2 text-center">
                      Keep up the great work! 🔥
                    </p>
                  </div>
                  
                  {/* Tooltip/Legend */}
                  <div className="mt-3 p-2 bg-gradient-to-r from-gray-50 to-blue-50 rounded-lg border border-gray-200">
                    <p className="text-xs text-gray-600 text-center">
                      💡 Hover over each indicator for detailed insights
                    </p>
                    <div className="flex justify-center gap-2 mt-1">
                      <div className="flex items-center gap-1">
                        <div className="w-2 h-2 bg-green-500 rounded-full"></div>
                        <span className="text-xs text-gray-500">High</span>
                      </div>
                      <div className="flex items-center gap-1">
                        <div className="w-2 h-2 bg-yellow-500 rounded-full"></div>
                        <span className="text-xs text-gray-500">Moderate</span>
                      </div>
                      <div className="flex items-center gap-1">
                        <div className="w-2 h-2 bg-red-500 rounded-full"></div>
                        <span className="text-xs text-gray-500">Low</span>
                      </div>
                    </div>
                  </div>
                </div>
              </GlassCard>

            {/* Daily Check-in */}
            {showCheckIn && (
              <AnimatedCard 
                className="shadow-xl"
                delay={0.6}
                glow={isStressed}
              >
                <DailyCheckIn
                  onComplete={handleCheckInComplete}
                  onSkip={() => setShowCheckIn(false)}
                  streakDays={nuriState?.streakDays || 0}
                />
              </AnimatedCard>
            )}

            {/* Health Tip */}
            {showHealthTip && (
              <AnimatedCard 
                className="shadow-xl"
                delay={0.8}
                shimmer={nuriState?.proEnabled || false}
              >
                <HealthTipCard
                  tip="Stay hydrated and get enough sleep for optimal health!"
                  onDismiss={() => setShowHealthTip(false)}
                />
              </AnimatedCard>
            )}

            {/* Enhanced Pro Upgrade Suggestion */}
            {!nuriState?.proEnabled && conversation.length > 2 && (
              <AnimatedCard 
                className="shadow-xl"
                delay={1.0}
                shimmer={true}
                glow={true}
              >
                <div className="p-6 bg-gradient-to-br from-yellow-50 to-amber-50 border-yellow-200 rounded-xl">
                  <div className="flex items-center gap-3 mb-3">
                    <Crown className="w-5 h-5 text-yellow-600 animate-pulse" />
                    <h4 className="font-semibold text-gray-800">Unlock Nuri Pro</h4>
                  </div>
                  <p className="text-sm text-gray-600 mb-3">
                    Get advanced features like mood tracking, journaling, and personalized insights.
                  </p>
                  <Button className="w-full bg-gradient-to-r from-yellow-500 to-amber-500 hover:from-yellow-600 hover:to-amber-600 text-white transition-all duration-300">
                    Learn More
                  </Button>
                </div>
              </AnimatedCard>
            )}
          </motion.div>
        </motion.div>
      </div>
      
      {/* Discrete Footer Link */}
      <div className="fixed bottom-4 right-4 z-40">
        <button
          onClick={() => setShowDataSources(true)}
          className="text-xs text-gray-400 hover:text-gray-600 transition-colors flex items-center gap-1"
        >
          <Shield className="w-3 h-3" />
          <span>Data Sources</span>
        </button>
      </div>
      
      {/* Data Sources Modal */}
      <DataSources 
        isOpen={showDataSources}
        onClose={() => setShowDataSources(false)}
      />
    </div>
    </>
  )
}

export default NuriAssistant