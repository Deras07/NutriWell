              ...nuriAnimationPresets.transition
            }}
            className="bg-white rounded-xl shadow-lg p-8 border border-gray-100"
            style={{
              background: `linear-gradient(135deg, rgba(255,255,255,0.95) 0%, rgba(255,255,255,0.98) 100%), ${nuriPersonality.gradient}`
            }}
          >
